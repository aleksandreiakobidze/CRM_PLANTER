{
  "name": "planter-crm",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:hostinger": "node scripts/make-mysql-schema.mjs && prisma generate --schema prisma/schema.mysql.prisma && prisma db push --schema prisma/schema.mysql.prisma && node scripts/hostinger-next-build.mjs",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "db:up": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate deploy",
    "admin:invite": "tsx scripts/invite-admin.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:fill": "tsx scripts/fill-demo.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource/noto-sans-georgian": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mariadb": "^3.5.4",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "prisma": "7.10.1",
    "@tailwindcss/postcss": "^4.1.14",
    "postcss": "^8.5.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.8.1",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.4.2",
    "vitest": "^3.2.4"
  }
}
