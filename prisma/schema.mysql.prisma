generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Organization {
  id                       String   @id @default(cuid())
  name                     String
  legalName                String?  @map("legal_name")
  identificationCode       String?  @map("identification_code")
  address                  String?
  directorName             String?  @map("director_name")
  bankName                 String?  @map("bank_name")
  iban                     String?
  currency                 String   @default("GEL")
  timezone                 String   @default("Asia/Tbilisi")
  taxMode                  String   @default("unset") @map("tax_mode")
  taxRate                  Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  isDemo                   Boolean  @default(false) @map("is_demo")
  portalEnabled            Boolean  @default(false) @map("portal_enabled")
  autoInvoiceAfterWaybill  Boolean  @default(false) @map("auto_invoice_after_waybill")
  rentalBufferHours        Int      @default(4) @map("rental_buffer_hours")
  excursionWindowStart     String   @default("10:00") @map("excursion_window_start")
  excursionWindowEnd       String   @default("17:00") @map("excursion_window_end")
  maintenanceDefaultPercent Decimal @default(10) @map("maintenance_default_percent") @db.Decimal(6, 2)
  createdAt                DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  memberships       Membership[]
  roles             Role[]
  invitations       Invitation[]
  customers         Customer[]
  species           Species[]
  products          Product[]
  variants          ProductVariant[]
  priceLists        PriceList[]
  locations         Location[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  reservations      Reservation[]
  quotes            Quote[]
  orders            SalesOrder[]
  fulfillments      Fulfillment[]
  returns           SalesReturn[]
  invoices          Invoice[]
  payments          Payment[]
  credits           CustomerCredit[]
  deposits          DepositTransaction[]
  expenses          Expense[]
  sequences         DocumentSequence[]
  importBatches     ImportBatch[]
  outbox            OutboxEvent[]
  jobs              Job[]
  rentalAssets      RentalAsset[]
  rentalBookings    RentalBooking[]
  assetReservations AssetReservation[]
  contracts         MaintenanceContract[]
  programs          ExcursionProgram[]
  excursionBookings ExcursionBooking[]
  resources         Resource[]
  connections       IntegrationConnection[]
  auditLogs         AuditLog[]
  savedViews        SavedView[]
  activities        Activity[]
  tasks             Task[]
  taskAttachments   TaskAttachment[]
  customerAttachments CustomerAttachment[]
  placeTerms         PlaceTerm[]
  customerPlants     CustomerPlant[]
  replacementCases   ReplacementCase[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  landedCosts        LandedCost[]
  growthBatches      GrowthBatch[]
  greenhouseTasks    GreenhouseTask[]
  inventoryCounts    InventoryCount[]
  greeningProjects   GreeningProject[]
  deliveryTasks      DeliveryTask[]
  routes             Route[]
  campaigns          Campaign[]
  eventBookings      EventBooking[]
  bankImportBatches  BankImportBatch[]
  portalAccounts     CustomerPortalAccount[]
  internalShipments  InternalShipment[]
  chatThreads        ChatThread[]
  userIntegrations   UserIntegration[]
  notifications      Notification[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique
  name         String
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  memberships     Membership[]
  sessions        Session[]
  tasks           Task[]
  createdTasks    Task[]           @relation("TaskCreator")
  taskAssignments TaskAssignment[]
  taskUploads     TaskAttachment[] @relation("TaskUploader")
  customerUploads CustomerAttachment[] @relation("CustomerUploader")
  invitations     Invitation[]     @relation("InvitationCreator")
  deliveryTasks   DeliveryTask[]   @relation("DeliveryDriver")
  routes          Route[]          @relation("RouteDriver")
  chatJoins       ChatParticipant[]
  chatMessages    ChatMessage[]     @relation("ChatAuthor")
  integrations    UserIntegration[]
  calendarLinks   CalendarSyncLink[]
  notifications   Notification[]

  @@map("users")
}

model Role {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  code           String
  nameKa         String @map("name_ka")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions  RolePermission[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id   String @id @default(cuid())
  code String @unique

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  userId         String  @map("user_id")
  roleId         String  @map("role_id")
  active         Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Session {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  email          String
  roleId         String    @map("role_id")
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  acceptedAt     DateTime? @map("accepted_at") @db.DateTime(3)
  createdById    String?   @map("created_by_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("invitations")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  actorId        String?  @map("actor_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  reason         String?
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model Customer {
  id                 String    @id @default(cuid())
  organizationId     String    @map("organization_id")
  kind               String
  name               String
  legalName          String?   @map("legal_name")
  directorName       String?   @map("director_name")
  identificationCode String?   @map("identification_code")
  segment            String    @default("other")
  relationshipStatus String    @default("fresh") @map("relationship_status")
  doNotContact       Boolean   @default(false) @map("do_not_contact")
  region             String?
  city               String?
  district           String?
  venueType          String?   @map("venue_type")
  phone              String?
  phoneNormalized    String?   @map("phone_normalized")
  email              String?
  website            String?
  mapsUrl            String?   @map("maps_url")
  latitude           Decimal?  @db.Decimal(9, 6)
  longitude          Decimal?  @db.Decimal(9, 6)
  source             String?
  priority           String?
  verification       String?
  notes              String?
  nextContactOn      DateTime? @map("next_contact_on") @db.Date
  ownerId            String?   @map("owner_id")
  mergedIntoId       String?   @map("merged_into_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mergedInto   Customer?    @relation("CustomerMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom   Customer[]   @relation("CustomerMerge")
  contacts     Contact[]
  addresses    Address[]
  activities   Activity[]
  tasks        Task[]
  quotes       Quote[]
  orders       SalesOrder[]
  invoices     Invoice[]
  payments     Payment[]
  credits      CustomerCredit[]
  bookings     RentalBooking[]
  contracts        MaintenanceContract[]
  excursions       ExcursionBooking[]
  projects         GreeningProject[]
  deliveryTasks    DeliveryTask[]
  eventBookings    EventBooking[]
  bankImportRows   BankImportRow[]
  portalAccounts   CustomerPortalAccount[]
  files            CustomerAttachment[]

  @@index([organizationId, relationshipStatus])
  @@index([organizationId, phoneNormalized])
  @@index([organizationId, identificationCode])
  @@index([organizationId, district])
  @@index([organizationId, venueType])
  @@index([organizationId, priority])
  @@map("customers")
}

model Contact {
  id              String  @id @default(cuid())
  organizationId  String  @map("organization_id")
  customerId      String  @map("customer_id")
  name            String
  title           String?
  phone           String?
  phoneNormalized String? @map("phone_normalized")
  email           String?
  isPrimary       Boolean @default(false) @map("is_primary")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId, phoneNormalized])
  @@index([customerId])
  @@map("contacts")
}

model Address {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  customerId     String  @map("customer_id")
  label          String  @default("მთავარი")
  line1          String  @map("line1")
  city           String?
  region         String?
  district       String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("addresses")
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  type           String
  result         String?
  body           String
  actorId        String?  @map("actor_id")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId, customerId, occurredAt])
  @@map("activities")
}

model Task {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  title          String
  description    String?
  dueOn          DateTime? @map("due_on") @db.Date
  priority       String    @default("normal")
  type           String    @default("follow_up")
  status         String    @default("open")
  assigneeId     String?   @map("assignee_id")
  createdById    String?   @map("created_by_id")
  customerId     String?   @map("customer_id")
  relatedType    String?   @map("related_type")
  relatedId      String?   @map("related_id")
  result         String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignee     User?            @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy    User?            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignments   TaskAssignment[]
  attachments   TaskAttachment[]
  calendarLinks CalendarSyncLink[]

  @@index([organizationId, assigneeId, status])
  @@index([organizationId, createdById])
  @@map("tasks")
}

model TaskAssignment {
  id          String    @id @default(cuid())
  taskId      String    @map("task_id")
  userId      String    @map("user_id")
  status      String    @default("open")
  completedAt DateTime? @map("completed_at") @db.DateTime(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@index([userId, status])
  @@map("task_assignments")
}

model TaskAttachment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  taskId         String   @map("task_id")
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  byteSize       Int      @map("byte_size")
  storageKey     String   @unique @map("storage_key")
  uploadedById   String   @map("uploaded_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  uploadedBy   User         @relation("TaskUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, taskId])
  @@map("task_attachments")
}

model CustomerAttachment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  kind           String
  fileName       String   @map("file_name")
  contentType    String   @map("content_type")
  byteSize       Int      @map("byte_size")
  storageKey     String   @unique @map("storage_key")
  uploadedById   String   @map("uploaded_by_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  uploadedBy   User         @relation("CustomerUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, customerId, kind])
  @@map("customer_attachments")
}

model PlaceTerm {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  kind           String
  name           String
  code           String   @default(cuid())
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, kind, name])
  @@unique([organizationId, code])
  @@index([organizationId, kind])
  @@map("place_terms")
}

model SavedView {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  userId         String @map("user_id")
  page           String
  name           String
  queryString    String @map("query_string")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, page])
  @@map("saved_views")
}

model Species {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  nameKa         String   @map("name_ka")
  nameLatin      String?  @map("name_latin")
  aliases        Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products     Product[]

  @@unique([organizationId, nameKa])
  @@map("species")
}

model Product {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  category       String
  nameKa         String  @map("name_ka")
  speciesId      String? @map("species_id")
  active         Boolean @default(true)
  light          String?
  water          String?
  humidity       String?
  careNotes      String? @map("care_notes")
  videoUrl       String? @map("video_url")
  frostHardiness String? @map("frost_hardiness")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  species      Species?         @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]

  @@index([organizationId, category])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  productId       String   @map("product_id")
  sku             String
  nameKa          String   @map("name_ka")
  heightCm        Decimal? @map("height_cm") @db.Decimal(10, 2)
  potVolumeLiters Decimal? @map("pot_volume_liters") @db.Decimal(10, 3)
  sellable        Boolean  @default(true)
  rentable        Boolean  @default(false)
  active          Boolean  @default(true)
  listPrice       Decimal  @default(0) @map("list_price") @db.Decimal(18, 4)
  unitCost        Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 4)
  averageCost     Decimal  @default(0) @map("average_cost") @db.Decimal(18, 4)
  barcode         String?
  internalCode    String?  @map("internal_code")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  balances     StockBalance[]
  movements    StockMovement[]
  reservations Reservation[]
  prices       PriceListEntry[]
  assets              RentalAsset[]
  purchaseLines       PurchaseOrderLine[]
  growthBatches       GrowthBatch[]
  countLines          InventoryCountLine[]
  landedAllocations   LandedCostAllocation[]
  shipmentLines       InternalShipmentLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, internalCode])
  @@map("product_variants")
}

model PriceList {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  code           String
  nameKa         String @map("name_ka")
  kind           String

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries      PriceListEntry[]

  @@unique([organizationId, code])
  @@map("price_lists")
}

model PriceListEntry {
  id          String    @id @default(cuid())
  priceListId String    @map("price_list_id")
  variantId   String    @map("variant_id")
  unitPrice   Decimal   @map("unit_price") @db.Decimal(18, 4)
  minQty      Decimal   @default(1) @map("min_qty") @db.Decimal(18, 3)
  validFrom   DateTime? @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([priceListId, variantId])
  @@map("price_list_entries")
}

model Location {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  code           String
  nameKa         String @map("name_ka")
  kind           String

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  balances     StockBalance[]
  assets       RentalAsset[]
  receipts     GoodsReceipt[]
  batches      GrowthBatch[]
  counts       InventoryCount[]
  shipmentsFrom InternalShipment[] @relation("ShipmentFrom")
  shipmentsTo   InternalShipment[] @relation("ShipmentTo")

  @@unique([organizationId, code])
  @@map("locations")
}

model StockBalance {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  variantId      String  @map("variant_id")
  locationId     String  @map("location_id")
  onHand         Decimal @default(0) @map("on_hand") @db.Decimal(18, 3)
  reserved       Decimal @default(0) @db.Decimal(18, 3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location     Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, variantId, locationId])
  @@map("stock_balances")
}

model StockMovement {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  variantId      String   @map("variant_id")
  locationId     String   @map("location_id")
  quantity       Decimal  @db.Decimal(18, 3)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(18, 4)
  movementType   String   @map("movement_type")
  postingKey     String   @unique @map("posting_key")
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id")
  reason         String?
  actorId        String?  @map("actor_id")
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([organizationId, variantId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([organizationId, sourceType, sourceId])
  @@map("stock_movements")
}

model Reservation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  variantId      String    @map("variant_id")
  locationId     String    @map("location_id")
  quantity       Decimal   @db.Decimal(18, 3)
  status         String
  sourceType     String    @map("source_type")
  sourceId       String    @map("source_id")
  postingKey     String    @unique @map("posting_key")
  expiresAt      DateTime? @map("expires_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([sourceType, sourceId])
  @@map("reservations")
}

model Quote {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  number         String
  customerId     String    @map("customer_id")
  status         String    @default("draft")
  validUntil     DateTime? @map("valid_until") @db.Date
  currency       String    @default("GEL")
  notes          String?
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines        QuoteLine[]
  order        SalesOrder?

  @@unique([organizationId, number])
  @@map("quotes")
}

model QuoteLine {
  id             String  @id @default(cuid())
  quoteId        String  @map("quote_id")
  kind           String  @default("item")
  variantId      String? @map("variant_id")
  description    String
  quantity       Decimal @db.Decimal(18, 3)
  unitPrice      Decimal @map("unit_price") @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(18, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(18, 2)
  sort           Int     @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@map("quote_lines")
}

model SalesOrder {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  number         String
  customerId     String   @map("customer_id")
  quoteId        String?  @unique @map("quote_id")
  status         String   @default("open")
  postingKey     String   @unique @map("posting_key")
  currency       String   @default("GEL")
  notes          String?
  orderedOn      DateTime @default(now()) @map("ordered_on") @db.Date
  version        Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quote        Quote?           @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  lines        SalesOrderLine[]
  fulfillments Fulfillment[]
  invoices     Invoice[]
  returns      SalesReturn[]

  @@unique([organizationId, number])
  @@map("sales_orders")
}

model SalesOrderLine {
